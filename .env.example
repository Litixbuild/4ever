# Copy this file to .env.local for local development.
# On Netlify, add each of these under Project configuration → Environment variables.
# SETUP.md explains where every value comes from.

# The public address of the site (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://4everclips.com

# Supabase → Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "publishable" key (older projects call it the "anon" key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The "secret" key (older projects call it "service_role"). Never share this one.
SUPABASE_SECRET_KEY=

# YouTube Data API v3 key (Google Cloud Console). Used to read video details
# and to verify that a creator owns their channel.
YOUTUBE_API_KEY=

# Twitch app (dev.twitch.tv/console). Use the same app you set up for Twitch login.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Comma-separated emails that become admins the first time they log in
ADMIN_EMAILS=you@example.com

# Any long random string. Used to count views without storing anyone's IP address.
VIEW_HASH_SALT=change-me-to-a-long-random-string

# Where people can reach you (shown on the Terms, Privacy and DMCA pages)
NEXT_PUBLIC_CONTACT_EMAIL=hello@4everclips.com

# Your DMCA designated agent, exactly as registered with the U.S. Copyright Office
NEXT_PUBLIC_DMCA_AGENT_NAME=
NEXT_PUBLIC_DMCA_AGENT_ADDRESS=
NEXT_PUBLIC_DMCA_EMAIL=dmca@4everclips.com
